DATABASE_URI=postgresql://user:password@localhost:5432/neptune_wheeler
PAYLOAD_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neptune AI chat assistant (Claude). Get a key at https://console.anthropic.com/
# Until this is set, the chat shows a friendly "offline — chat on WhatsApp" message.
ANTHROPIC_API_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = no analytics. Loads in production only,
# after the visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Search Console HTML-tag verification code (fallback; a DNS TXT record on the domain is preferred).
NEXT_PUBLIC_GSC_VERIFICATION=
